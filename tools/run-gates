#!/usr/bin/env bash
# run-gates — every conformance gate, in dependency order, on one machine.
#
# CI runs the same set (.github/workflows/ci.yml); this script exists so a
# laptop can reproduce a red build without reading the workflow.
#
# Order matters: verify-ipc-signing inspects built APKs, so the build runs
# first. Set GRADLE_ARGS to add flags (e.g. "--no-daemon").

set -u
cd "$(dirname "$0")/.." || exit 1

GRADLE_BIN="${GRADLE_BIN:-gradle}"
GRADLE_ARGS="${GRADLE_ARGS:-}"
FAIL=0
PASS=0

step() {
  local name="$1"; shift
  echo
  echo "== $name =="
  if "$@"; then
    PASS=$((PASS + 1))
    echo "-> $name: OK"
  else
    FAIL=$((FAIL + 1))
    echo "-> $name: FAILED" >&2
  fi
}

gradle_run() {
  # shellcheck disable=SC2086
  $GRADLE_BIN --console=plain $GRADLE_ARGS "$@"
}

step "build (APKs for the signing gate)" gradle_run \
  :app:assembleServer29Debug \
  :app:assemblePeripheral26Debug \
  :testapps:samecert:assembleDebug \
  :testapps:foreigncert:assembleDebug

# `--rerun` forces exactly the test tasks listed here to execute even when the
# build cache holds a result for them. That is deliberate: a cached entry once
# restored five result files for the whole engine suite (a filtered run had
# written it), the gate went green, and "all tests pass" meant "43 of ~840
# ran". A gate that can be satisfied by the cache is not a gate. Compilation
# stays cached; only the tests always run.
#
# The result files are removed first, and the run is checked afterwards, because
# the same lie arrives by a second road: `tools/test-agent` runs this same task
# with `--tests`, and Gradle writes (and clears) one results directory per task.
# The filtered run therefore erased the full suite's evidence and left five
# files behind. `tools/check-test-reports` compares the classes that exist with
# the classes Gradle says it ran, so a subset is a failure no matter how the
# narrowing happened.
jvm_tests() {
  rm -rf engine/build/test-results sdk/build/test-results \
    examples/connect/build/test-results app/build/test-results
  gradle_run \
    :engine:testDebugUnitTest \
    :sdk:testDebugUnitTest \
    :examples:connect:testDebugUnitTest \
    :app:testServer29DebugUnitTest \
    :app:testPeripheral26DebugUnitTest \
    --rerun &&
    ./tools/check-test-reports
}

step "JVM tests (engine, sdk, the client example and both flavours)" jvm_tests

# The check count is not repeated in this label: it was hardcoded, it drifted
# (it said 73 while test-policy ran 77), and test-policy prints the real number
# itself on the line below.
step "static policy" ./tools/test-policy
step "third-party ledger" ./tools/check-third-party
step "IPC signing (C-008)" ./tools/verify-ipc-signing
step "flavour contents (D87)" ./tools/check-flavours
step "agent secrets (stdin, not argv)" ./tools/test-agent
step "agent runtime protocol (node)" ./tools/test-agent-runtime
step "download page (static, no third parties)" ./tools/check-site
step "fleet view self-test" ./tools/test-fleet
step "hub roster self-test" ./tools/test-hub
step "provisioning self-test" ./tools/test-provision
step "Android lint (both flavours)" gradle_run :app:lintServer29Debug :app:lintPeripheral26Debug

echo
if [ "$FAIL" -ne 0 ]; then
  echo "run-gates: FAILED ($PASS passed, $FAIL failed)" >&2
  exit 1
fi
echo "run-gates: OK ($PASS gates)"
