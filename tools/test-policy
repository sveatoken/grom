check "the embedded example is a real module in the gate and in ci" \
  bash -c "grep -q 'include(\":examples:embedded\")' settings.gradle.kts && grep -q 'implementation(project(\":engine\"))' examples/embedded/build.gradle.kts && grep -q 'GromEmbed.start' examples/embedded/src/main/java/app/grom/examples/embedded/EmbedExample.kt && grep -q ':examples:embedded:testDebugUnitTest' tools/run-gates && grep -q 'examples/embedded/build/test-results' tools/check-test-reports && grep -q 'examples:embedded:testDebugUnitTest' .github/workflows/ci.yml && grep -q 'pickFirsts' docs/TWO-IN-ONE.md && grep -q 'META-INF/DEPENDENCIES' docs/TWO-IN-ONE.md"

