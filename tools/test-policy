#!/usr/bin/env bash
# test-policy — static invariants that must never regress.
#
# These are the checks that cannot be expressed as a unit test because they are
# about the shape of the tree: manifest permissions, absent symbols, headers.
# See D1, D2, D5, D15, D18, D21, D39…D103 and S1-R002…S1-R048,
# S5-R001…S5-R058, S6-R001…S6-R028, S8-R001…S8-R014.
#
# The gate is intentionally a fixed count: the final line reports it.

set -u
cd "$(dirname "$0")/.." || exit 1

MAIN="engine/src/main/java/app/grom/server"
APP_MAIN="app/src/main/java/app/grom/server"
AIDL="sdk/src/main/aidl/app/grom/sdk/ipc/IGromServer.aidl"
MANIFEST_MAIN="app/src/main/AndroidManifest.xml"
MANIFEST_SERVER="app/src/server29/AndroidManifest.xml"
MANIFEST_ENGINE="engine/src/main/AndroidManifest.xml"
FAIL=0
PASS=0

check() {
  local name="$1"; shift
  if "$@" >/dev/null 2>&1; then
    PASS=$((PASS + 1))
  else
    echo "FAIL: $name" >&2
    FAIL=$((FAIL + 1))
  fi
}

echo "== test-policy =="

# 1. signature-level permission is declared
check "signature permission declared" \
  grep -q 'BIND_GROMSERVER' "$MANIFEST_MAIN" 

# 2. the permission uses protectionLevel signature
#    (wrapped in bash -c: a bare pipeline would run the counter in a subshell)
check "protectionLevel=signature" \
  bash -c "grep -A1 'BIND_GROMSERVER' '$MANIFEST_MAIN' | grep -q 'protectionLevel=\"signature\"'"

# 3. the service is gated by that permission
check "service gated by permission" \
  grep -q 'android:permission="app.grom.sdk.ipc.BIND_GROMSERVER"' "$MANIFEST_SERVER"

# 4. the server role declares a foreground service type
check "foregroundServiceType specialUse" \
  grep -q 'foregroundServiceType="specialUse"' "$MANIFEST_SERVER"

# 5. the control-plane bind policy allows exactly the loopback literals
check "control bind allow-list" \
  grep -q 'setOf("127.0.0.1", "::1")' "$MAIN/core/BindPolicy.kt"

# 6. no wildcard bind literal outside the two bind-policy files (D39)
check "no wildcard bind outside a bind policy" \
  bash -c "! grep -rn '\"0\.0\.0\.0\"' $MAIN --include='*.kt' | grep -vE 'core/(Super)?BindPolicy\.kt'"

# 7. no hostname resolution on the bind path (S5-R005). The rule is about the
#    address the data plane binds, which must be a literal; a dialled SSH target
#    is a name the operator typed, and resolving it once is how a typo gets its
#    own code instead of "handshake failed" (D105).
check "no InetAddress.getByName on the bind path" \
  bash -c "! grep -rn 'InetAddress.getByName' $MAIN/core $MAIN/superserver $MAIN/mesh --include='*.kt'"

# 8. token comparison is constant time
check "constant-time token compare" \
  grep -q 'MessageDigest.isEqual' "$MAIN/core/Token.kt"

# 9. the audit chain uses SHA-256
check "audit chain uses SHA-256" \
  bash -c "grep -q 'SHA-256' $MAIN/core/AuditChain.kt && grep -q 'SHA-256' $MAIN/core/Token.kt"

# 10. money vocabulary is confined to the Lightning adapter (D43, S1-R002 amended)
#     Grom still has no ledger and custodies nothing: the adapter only forwards
#     to an external backend, and the rest of the server never speaks money.
check "money vocabulary only inside the Lightning adapter" \
  bash -c "! grep -rniE 'payment|ledger|settlement|\bbalance\b|invoice' $MAIN --include='*.kt' | grep -v 'superserver/plugins/lightning/'"

# 11. every Kotlin source carries an SPDX header
# Depend on grep's *output*, not on find's exit status: GNU findutils
# versions disagree about whether a failing -exec command makes find fail, and
# the CI runner's version turned this check red on a tree with all headers
# present. An empty list is the pass condition.
check "SPDX headers on all Kotlin sources" \
  bash -c "[ -z \"\$(find app sdk engine -name '*.kt' -not -path '*/build/*' -exec grep -L 'SPDX-License-Identifier: Apache-2.0' {} +)\" ]"

# 12. the repository licence is Apache-2.0
check "LICENSE is Apache-2.0" \
  grep -q 'Apache License' LICENSE

# 13. boot restart is opt-in
check "boot restart is opt-in" \
  grep -q 'GromPrefs.startOnBoot' "$MAIN/service/BootReceiver.kt"

# 14. quarantined agents do not restart at boot
check "boot respects quarantine" \
  grep -q 'isQuarantined' "$MAIN/ServerRuntime.kt"

# 15. every IPC transaction checks signatures. The number is not a magic
#     constant: it must be exactly one gate per AIDL method, plus the gate's own
#     definition. The previous `-ge 38` floor counted that definition too, so a
#     new method shipped without its gate left the total unchanged and passed.
#     Comparing against the AIDL itself makes an ungated method fail the gate.
check "every IPC transaction applies the signature gate" \
  bash -c "[ \$(grep -c 'requireSameSigner()' $MAIN/service/GromService.kt) -eq \$(( \$(grep -cE '^[[:space:]]+(String|void|int) [a-zA-Z]+\(' $AIDL) + 1 )) ]"

# 16. cleartext outbound traffic is not enabled
check "no usesCleartextTraffic" \
  bash -c "! grep -rq 'usesCleartextTraffic' app/src engine/src"

# 17. exactly two hosts may be compiled in, and each in exactly one file: the
#     operator-initiated update feed (D37, S1-R003/S1-R033) and the Telegram Bot
#     API the operator enables (D65, S1-R038). A Lightning backend URL is
#     supplied at runtime, never compiled in (D48).
#     The pattern requires a host character after the scheme: a literal like
#     startsWith("https://") is a security check, not an endpoint.
check "compiled outbound hosts are allow-listed defaults, never call sites" \
  bash -c "! grep -rnE 'https?://[A-Za-z0-9]' $MAIN $APP_MAIN --include='*.kt' --exclude='UpdateChecker.kt' --exclude='TelegramNotifier.kt' --exclude='AiProvider.kt' && grep -q 'https://api.github.com/repos/' $APP_MAIN/update/UpdateChecker.kt && grep -q 'https://api.telegram.org' $MAIN/notify/TelegramNotifier.kt && [ \$(grep -rl 'api\.telegram\.org' $MAIN --include='*.kt' | wc -l) -eq 1 ] && [ \$(grep -rl 'https://api\.openai\.com' $MAIN --include='*.kt' | wc -l) -eq 1 ] && ! grep -q 'api\.openai\.com' $MAIN/superserver/plugins/ai/AiGateway.kt && ! grep -q 'api\.openai\.com' $MAIN/superserver/plugins/ai/AiDocuments.kt"

# 18. binding every interface requires an explicit acknowledgement (D41)
check "public bind requires acknowledgement" \
  bash -c "grep -q 'PUBLIC_NOT_ACKNOWLEDGED' $MAIN/superserver/SuperServerConfig.kt"

# 19. password handling is PBKDF2-SHA256 with a constant-time comparison (D42)
check "password uses PBKDF2-SHA256 and constant-time compare" \
  bash -c "grep -q 'PBKDF2WithHmacSHA256' $MAIN/superserver/auth/PasswordHash.kt && grep -q 'MessageDigest.isEqual' $MAIN/superserver/auth/PasswordHash.kt"

# 20. signed requests reject replays by nonce (D42, D45)
check "Ed25519 requests have replay protection" \
  grep -q 'SIGNATURE_REPLAYED' "$MAIN/superserver/auth/RequestSigner.kt"

# 21. a backend URL must be https, so the backend credential cannot leak (D44)
check "backend URL must be https" \
  bash -c "grep -q 'INSECURE_BACKEND_URL' $MAIN/superserver/SuperServerConfig.kt && grep -q 'startsWith(\"https://\")' $MAIN/superserver/SuperServerConfig.kt"

# 22. the super server is built from code, never loaded dynamically (D39)
check "no dynamic plugin loading" \
  bash -c "! grep -rnE 'Class\.forName|DexClassLoader|PathClassLoader|ScriptEngine' $MAIN/superserver --include='*.kt'"

# 23. the npub / relay reference package never opens a connection (D52).
#     Relays are reference configuration for an external VPS; Grom itself has
#     no WebSocket client and no outbound HTTP in this package.
check "nostr reference package opens no connection" \
  bash -c "! grep -rnE 'Socket|openConnection|HttpURLConnection|WebSocket|okhttp|java\.net\.URL' $MAIN/superserver/nostr --include='*.kt'"

# 24. the status document and the config export are allow-lists, never a
#     serialisation of the whole config (D53). A credential field appearing in
#     either file is a leak, so the identifiers must be absent outright.
check "status and export carry no credential fields" \
  bash -c "! grep -rnE 'passwordHash|apiKeySealed|nsec1|PRIVATE KEY' $MAIN/superserver/SuperStatusDocument.kt $MAIN/superserver/ConfigExport.kt $MAIN/notify/NotifyStatus.kt"

# 25. the engine declares its service privately, for embedded hosts (D55)
check "engine service is not exported" \
  bash -c "grep -q 'exported=\"false\"' $MANIFEST_ENGINE"

# 26. the standalone role replaces it with the signature-gated export (D55)
check "server29 replaces the service with the gated export" \
  bash -c "grep -q 'tools:node=\"replace\"' $MANIFEST_SERVER && grep -q 'exported=\"true\"' $MANIFEST_SERVER"

# 27. outbound client sockets exist only where a documented feature needs them:
#     the loopback agent client, the operator's Lightning backend, the SSH bridge
#     (D58) and the alert delivery (D65). Server sockets are separate and covered
#     by check 6. A notifier reaches the network only through the shared
#     transport seam, so it holds no socket symbol of its own.
check "outbound client sockets confined to documented features" \
  bash -c "! grep -rnE '\bSocket\s*\(|HttpURLConnection|openConnection' $MAIN --include='*.kt' | grep -vE '/(agent|ssh|notify)/|superserver/net/|mesh/net/|mesh/android/'"

# 28. no private key material is committed; keys are generated on the device
check "no committed private key material" \
  bash -c "! grep -rnE 'PRIVATE KEY-----.{0,2}[A-Za-z0-9+/]{40}' $MAIN --include='*.kt'"

# 29. the SSH bridge opens only a remote tcpip-forward: no shell, exec or
#     subsystem, and the client-side filter allows only the local data plane.
check "sshd surface is tcpip-forward only" \
  bash -c "! grep -rnE 'createExecChannel|createShellChannel|createSubsystemChannel' $MAIN --include='*.kt' && grep -q 'startRemotePortForwarding' $MAIN/ssh/SshTunnelManager.kt && grep -q 'SshForwardingPolicy' $MAIN/ssh/SshTunnelManager.kt"

# 30. a project reaches only its own key namespace (D61). The prefix is
#     computed by the engine, the op list is fixed, and an unregistered project
#     is refused; none of that may be left to the caller.
check "project key/value ops are namespaced by the engine" \
  bash -c "grep -q 'ProjectNamespace.buildRequest(projectId' $MAIN/ServerRuntime.kt && grep -q 'fun buildRequest' $MAIN/projects/ProjectNamespace.kt && grep -q 'to scope(projectId, rawKey)' $MAIN/projects/ProjectNamespace.kt && grep -q 'PROJECT_KEY_INVALID' $MAIN/projects/ProjectNamespace.kt && grep -q 'PROJECT_NOT_REGISTERED' $MAIN/ServerRuntime.kt && grep -q 'String projectExec' sdk/src/main/aidl/app/grom/sdk/ipc/IGromServer.aidl"

# 31. the external Lightning node is a reference, not a client (D63): no gRPC,
#     no NWC, no socket, and no outbound URL in that file.
check "external node reference opens no connection" \
  bash -c "! grep -rnE 'Socket\s*\(|openConnection|HttpURLConnection|okhttp|java\.net\.URL|ManagedChannel|grpc' $MAIN/superserver/plugins/lightning/ExternalNodeRef.kt"

# 32. notifications are bounded by construction (D66): no repeating task of any
#     kind, a fixed queue and a fixed per-minute ceiling, and exactly one retry
#     site so "two attempts" stays a fact rather than an intention.
check "notification delivery has no scheduler and one retry site" \
  bash -c "! grep -rnE 'ScheduledExecutorService|scheduleAtFixedRate|scheduleWithFixedDelay|Executors\.newScheduled|java\.util\.Timer' $MAIN/notify --include='*.kt' && grep -q 'MAX_QUEUE' $MAIN/notify/TelegramNotifier.kt && grep -q 'MAX_PER_MINUTE' $MAIN/notify/TelegramNotifier.kt && [ \$(grep -c 'if (!outcome.ok && outcome.retryable)' $MAIN/notify/TelegramNotifier.kt) -eq 1 ]"

# 33. the bot token reaches the disk only through the Keystore box (D67), and
#     the public projection never carries the token or the chat id — the chat id
#     identifies the operator, so it is device state, not status.
check "notification token is sealed and absent from the public projection" \
  bash -c "grep -q 'secretBox\.seal(' $MAIN/notify/NotifySettingsStore.kt && grep -q 'secretBox\.open(' $MAIN/notify/NotifySettingsStore.kt && ! grep -q 'tokenSealed' $MAIN/notify/NotifyStatus.kt && ! grep -q 'chatId' $MAIN/notify/NotifyStatus.kt"


# 34. the fleet client reaches the network only through the shared transport
#     (D75). A socket symbol here would be a second, unaudited way out.
check "fleet client holds no socket symbol" \
  bash -c "! grep -rnE '\bSocket\s*\(|HttpURLConnection|openConnection|okhttp|java\.net\.URL' $MAIN/cluster --include='*.kt'"

# 35. the identity seed reaches the disk only through the Keystore box (D72),
#     and the public projections never name it. `FleetStatus` is the only fleet
#     block that leaves the device, so it must not carry key material.
check "identity seed is sealed and absent from public documents" \
  bash -c "grep -q 'secretBox\.seal(' $MAIN/cluster/NodeIdentity.kt && ! grep -qE 'seed|privateKey' $MAIN/cluster/FleetStatus.kt $MAIN/superserver/ConfigExport.kt $MAIN/superserver/SuperStatusDocument.kt"

# 36. pairing is explicit and bounded (D71): a constant-time code compare, a
#     session TTL, a capped number of attempts, and no path that opens a
#     session except the operator action.
check "pairing is constant-time, bounded and explicitly opened" \
  bash -c "grep -q 'MessageDigest.isEqual' $MAIN/cluster/Pairing.kt && grep -q 'SESSION_TTL_MS' $MAIN/cluster/Pairing.kt && grep -q 'MAX_ATTEMPTS' $MAIN/cluster/Pairing.kt && grep -q 'fun open()' $MAIN/cluster/Pairing.kt"

# 37. peer access is scoped (D73), health is answered before any credential
#     work, and the fleet status block names no address (D59).
check "peers are scoped and no address reaches status" \
  bash -c "grep -q 'SCOPE_REQUIRED' $MAIN/superserver/SuperRouter.kt && grep -q 'hasScope' $MAIN/superserver/SuperRouter.kt && ! grep -q '\"address\"' $MAIN/cluster/FleetStatus.kt && awk '/path == HEALTH/{h=NR} /auth\.authenticate/{a=NR} END{exit !(h>0 && a>h)}' $MAIN/superserver/SuperRouter.kt"

# 38. a remote forward port is unique per host (D78). Two saved servers on one
#     VPS asking for the same port would collide at connect time, so the store
#     refuses the second one before it can write.
check "a remote forward port is unique per host" \
  bash -c "grep -q 'BAD_FORWARD_PORT_CONFLICT' $MAIN/ssh/SshTarget.kt && grep -q 'fun forwardPortConflict' $MAIN/ssh/SshTarget.kt && grep -q 'forwardPortConflict(' $MAIN/ssh/SshTargetStore.kt && grep -q 'BAD_FORWARD_PORT_CONFLICT' engine/src/test/java/app/grom/server/ssh/SshTargetStoreTest.kt"

# 39. a server refusing the remote port is its own failure, not "the network is
#     down". The forward call sits in its own try with its own catch (D78).
check "a refused forward is a distinct failure" \
  bash -c "grep -q 'SSH_FORWARD_REFUSED' $MAIN/ssh/SshTunnelManager.kt && grep -q 'catch (refused: Throwable)' $MAIN/ssh/SshTunnelManager.kt && grep -q 'SSH_FORWARD_REFUSED' engine/src/test/java/app/grom/server/ssh/SshTunnelManagerTest.kt"

# 40. a one-way grant (D77) has no address, so it is never dialled, and the
#     grant path cannot mint an operator: a stored peer is always a Peer.
check "an inbound-only grant is never dialled" \
  bash -c "grep -q 'PEER_NO_ADDRESS' $MAIN/cluster/PeerClient.kt && grep -q 'fun isInboundOnly' $MAIN/cluster/PeerRecord.kt && grep -q 'isInboundOnly()' $MAIN/cluster/FleetService.kt && grep -q 'fun grant(' $MAIN/cluster/PeerStore.kt && ! grep -q 'Principal.Operator' $MAIN/cluster/PeerStore.kt && grep -q 'Principal.Peer(peer.nodeId, peer.grantedByMe, peer.services)' $MAIN/cluster/FleetService.kt"

# 41. the hub roster names devices and nothing else (D78): a port, an address
#     or a key in that projection would let the roster file leak the topology.
check "the hub roster carries no address or key" \
  bash -c "grep -q 'ROSTER_FIELDS' tools/hub/GromHub.java && ! grep -qE 'ROSTER_FIELDS[[:space:]]*=[[:space:]]*List\.of\([^)]*(url|address|port|publicKey|key)' tools/hub/GromHub.java && grep -q '\"label\", \"nodeId\", \"state\", \"lastSeenMs\", \"lastError\"' tools/hub/GromHub.java"

# 42. the provisioning tool can only read a phone, install the APK the operator
#     names, and ask for a battery exemption (D79). It talks to adb through an
#     argument list, never a shell string, and it contains no command that could
#     destroy device state — the words themselves are banned from that file, so
#     the guard inside it can only ever describe what the tool actually ran.
check "the provisioning tool destroys nothing and never uses a shell" \
  bash -c "grep -q 'ProcessBuilder' tools/provision/GromProvision.java && ! grep -qE 'Runtime\.getRuntime|\"sh\", *\"-c\"' tools/provision/GromProvision.java && ! grep -qE 'uninstall|pm clear|reboot|kill|force-stop|format-userdata' tools/provision/GromProvision.java && grep -q 'INSTALL_TIMEOUT_MS' tools/provision/GromProvision.java"

# 43. the Doctor has exactly one thin Android adapter (D80). Everything that
#     decides -- thresholds, exit-reason levels, the verdict -- is pure Kotlin, so
#     it is JVM-tested; a second file with a platform import would move a decision
#     into a layer no unit test can reach.
check "doctor has exactly one Android adapter" \
  bash -c "[ \$(grep -rl 'import android\.' $MAIN/doctor --include='*.kt' | wc -l) -eq 1 ] && grep -q 'import android\.' $MAIN/doctor/AndroidDoctorProbe.kt && ! grep -q 'import android\.' $MAIN/doctor/DoctorRules.kt && ! grep -q 'import android\.' $MAIN/doctor/DoctorFacts.kt && ! grep -q 'import android\.' $MAIN/doctor/DoctorFacade.kt && ! grep -q 'import android\.' $MAIN/doctor/DoctorDocument.kt && ! grep -q 'import android\.' $MAIN/doctor/RunMarkerStore.kt"

# 44. the Doctor never shells out (D80, D81). The deeper system facts -- the Doze
#     whitelist, the phantom-process limit, app-ops -- are read by the operator
#     over adb, so no shell, no dumpsys and no exec may exist in this package.
check "doctor never shells out" \
  bash -c "! grep -rnE 'ProcessBuilder|Runtime\.getRuntime|\.exec\(|/system/bin|"sh",|dumpsys|logcat' $MAIN/doctor --include='*.kt'"

# 45. the Doctor has no background loop (D80). It measures when the operator
#     opens the screen or taps the button; a timer here would be a battery cost
#     nobody asked for and a second, silent poll beside the request path.
check "doctor has no scheduler and no receiver" \
  bash -c "! grep -rnE 'ScheduledExecutorService|scheduleAtFixedRate|scheduleWithFixedDelay|Executors\.newScheduled|java\.util\.Timer|postDelayed|BroadcastReceiver' $MAIN/doctor --include='*.kt'"

# 46. the Doctor permission budget (D82). Two normal permissions, and no
#     blanket package, usage-stats or overlay permission anywhere in the tree;
#     the one-tap exemption dialog may only be requested when the permission that
#     authorises it is declared.
check "doctor permissions stay inside the agreed budget" \
  bash -c "grep -q 'ACCESS_NETWORK_STATE' $MANIFEST_ENGINE && grep -q 'REQUEST_IGNORE_BATTERY_OPTIMIZATIONS' $MANIFEST_ENGINE && ! grep -rqE 'QUERY_ALL_PACKAGES|PACKAGE_USAGE_STATS|SYSTEM_ALERT_WINDOW' $MANIFEST_ENGINE $MANIFEST_MAIN $MANIFEST_SERVER && grep -q 'ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS' $APP_MAIN/GromActivity.kt && grep -q 'REQUEST_IGNORE_BATTERY_OPTIMIZATIONS' $MANIFEST_ENGINE"

# 47. the Doctor stays local apart from three booleans (D84). The status block is
#     an allow-list, and neither the status document nor the config export may
#     grow a Doctor section.
check "the doctor block is three fields and stays out of the exports" \
  bash -c "grep -q 'DOCTOR_STATUS_FIELDS\|statusBlock(' $MAIN/doctor/DoctorDocument.kt && ! grep -q 'batteryExempt' $MAIN/superserver/ConfigExport.kt $MAIN/superserver/SuperStatusDocument.kt $MAIN/cluster/FleetStatus.kt && ! grep -q '\"doctor\"' $MAIN/superserver/ConfigExport.kt $MAIN/superserver/SuperStatusDocument.kt && grep -q '\"doctor\" to doctor()' $MAIN/superserver/SuperServerHost.kt"

# 48. the contract version has exactly one source (D29). `apiVersion()` answered
#     3 while the contract said 5, and 7 while it said 8, because the runtime
#     kept its own literal that nobody bumped. The runtime must therefore report
#     the SDK constant and carry no numeric literal of its own.
check "the runtime reports the SDK's API version, not its own literal" \
  bash -c "grep -q 'override fun apiVersion(): Int = GromClient.API_VERSION' $MAIN/ServerRuntime.kt && ! grep -qE 'override fun apiVersion\(\): Int = [0-9]' $MAIN/ServerRuntime.kt && grep -q 'const val API_VERSION: Int = 12' sdk/src/main/java/app/grom/sdk/GromClient.kt"

# 49. a phone can hold two Groms (D85). The embedding host must be able to pick
#     the loopback control port, and a port that is taken must be reported as
#     PORT_IN_USE — not as a signature or network failure. The probe and the
#     refusal code are the seam both the host and the tests agree on.
check "the control port is host-choosable and a conflict is named" \
  bash -c "grep -q 'val controlPort: Int? = null' $MAIN/embed/GromEmbed.kt && grep -q 'GromPrefs.setPort' $MAIN/embed/GromEmbed.kt && grep -q 'ControlPort.resolve' $MAIN/embed/GromEmbed.kt && grep -q 'ControlPort.PORT_IN_USE' $MAIN/ServerRuntime.kt && grep -q 'const val PORT_IN_USE' $MAIN/core/ControlPort.kt"

# 50. a host configures the data plane through one contract (D86). The Binder
#     path and the standalone screen must not be two policies: the runtime may
#     only produce a saved config through SuperServerConfigInput.parse, whose
#     refusals are the screen's own. The returned status carries passwordSet and
#     key ids, never a hash or a secret.
check "host config save goes through the screen's one validation contract" \
  bash -c "grep -q 'SuperServerConfigInput.parse(raw, port)' $MAIN/ServerRuntime.kt && grep -q 'String superSaveConfig' $AIDL && grep -q 'superSaveConfig' $MAIN/service/GromService.kt && grep -q 'fun saveConfig' $MAIN/superserver/SuperServerHost.kt && grep -q '\"passwordSet\"' $MAIN/superserver/SuperServerHost.kt && ! grep -q '\"passwordHash\" to' $MAIN/superserver/SuperServerHost.kt"

# 51. the peripheral role carries no runtime it never executes (D87). The
#     exclusion is per variant, so moving the libraries back into a shared
#     source set cannot silently grow the peripheral APK by ~91 MB.
check "the peripheral flavour excludes the native runtime it never runs" \
  bash -c "grep -q 'withFlavor(\"role\" to \"peripheral26\")' app/build.gradle.kts && grep -q 'packaging.jniLibs.excludes' app/build.gradle.kts"

# 52. the embed layer a host is told to call is pure and testable (D90). The
#     health projection decides which lamp the host paints, so it must not carry
#     an Android dependency: its rules have to run as JVM tests like the Doctor's.
check "the host-facing embed model is pure Kotlin" \
  bash -c "! grep -q '^import android\.' $MAIN/embed/EmbedHealth.kt && ! grep -q '^import android\.' $MAIN/embed/EmbedConsent.kt && grep -q 'class EmbedHealthTest' engine/src/test/java/app/grom/server/embed/EmbedHealthTest.kt"

# 53. consent and the port are decided before the service is asked to start
#     (D88, D89): a versioned consent gate, an opt-in automatic port, and a
#     resolved port that is persisted rather than assumed.
check "start routes through the consent gate and the port decision" \
  bash -c "grep -q 'EmbedConsent.refusal' $MAIN/embed/GromEmbed.kt && grep -q 'ControlPort.resolve' $MAIN/embed/GromEmbed.kt && grep -q 'GromPrefs.setPort(app, choice.port)' $MAIN/embed/GromEmbed.kt && grep -q 'const val AUTO_PORT' $MAIN/core/ControlPort.kt && grep -q 'val AUTO_RANGE' $MAIN/core/ControlPort.kt && grep -q 'CONSENT_OUTDATED' $MAIN/embed/EmbedConsent.kt"

# 54. every stable code the embed layer can return is documented for the host
#     (D90). A code that only exists in the code is a sentence the host must
#     invent, and the guide is the contract a host reads.
check "every embed code is documented in the 2-in-1 guide" \
  bash -c '
    for f in "$MAIN/embed/EmbedHealth.kt" "$MAIN/embed/EmbedConsent.kt" "$MAIN/core/ControlPort.kt"; do
      for code in $(grep -oE "\"[A-Z][A-Z0-9_]{4,}\"" "$f" | tr -d "\"" | sort -u); do
        grep -q "$code" docs/TWO-IN-ONE.md || { echo "undocumented code: $code"; exit 1; }
      done
    done
  '

# 55. the notification worker is closed when the service dies (D66). It used to
#     be closed nowhere: every service instance left one `grom-notify` thread
#     behind, which is invisible in the standalone app and a slow leak in a host
#     that stops and starts the embedded server.
check "the notification worker is closed after the final flush" \
  bash -c "grep -q 'runtime.closeNotifications()' $MAIN/service/GromService.kt && grep -q 'notifier.close()' $MAIN/ServerRuntime.kt && grep -q 'fun closeNotifications' $MAIN/ServerRuntime.kt"

# 56. a client discovers Grom through one data-plane route (D91). The route is
#     named once and served from the router; the host supplies the version, so
#     the document cannot report a version the build did not stamp.
check "the connect document is a named data-plane route" \
  bash -c "grep -q 'const val CONNECT: String = \"/grom/v1/connect\"' $MAIN/superserver/SuperRouter.kt && grep -q 'connectDocument' $MAIN/superserver/SuperRouter.kt && grep -q 'gromVersion = version' $MAIN/superserver/SuperServerHost.kt && grep -q 'version = { hostVersion(context) }' $MAIN/ServerRuntime.kt"

