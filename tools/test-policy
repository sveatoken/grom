check "an ssh failure is diagnosed by stage, not by exception class" \
  bash -c "grep -q 'enum class Stage' $MAIN/ssh/SshTunnelManager.kt && grep -q 'SSH_AUTH_FAILED' $MAIN/ssh/SshTunnelManager.kt && grep -q 'SSH_HOST_UNKNOWN' $MAIN/ssh/SshTunnelManager.kt && grep -q 'SSH_HOST_UNREACHABLE' $MAIN/ssh/SshTunnelManager.kt && grep -q 'SSH_HANDSHAKE_FAILED' $MAIN/ssh/SshTunnelManager.kt && grep -q 'stage.set(Stage.AUTH)' $MAIN/ssh/SshTunnelManager.kt && grep -q 'hasCause<' $MAIN/ssh/SshTunnelManager.kt && ! grep -q 'is java.io.IOException -> \"SSH_UNAVAILABLE\"' $MAIN/ssh/SshTunnelManager.kt && grep -q 'if (!accepted && (pinned != null || trust != null)) mismatch.set(true)' $MAIN/ssh/SshTunnelManager.kt"

