#!/usr/bin/env bash
# test-agent — prove that secrets reach the agent over stdin, never argv/env
# (D11, S3-R005…S3-R009).
#
# Two layers:
#   static  — the launcher builds argv from a fixed list and takes the token
#             only into the stdin payload;
#   dynamic — the JVM tests exercise a real LaunchSpec and assert the token is
#             absent from argv and from every environment value.

set -u
cd "$(dirname "$0")/.." || exit 1

LAUNCHER="engine/src/main/java/app/grom/server/agent/AgentLauncher.kt"
CONFIG="engine/src/main/java/app/grom/server/core/AgentConfig.kt"
PROCESS="engine/src/main/java/app/grom/server/agent/NodeAgentProcess.kt"

FAIL=0
PASS=0

check() {
  local name="$1"; shift
  if "$@" >/dev/null 2>&1; then
    PASS=$((PASS + 1))
    echo "  ok   $name"
  else
    FAIL=$((FAIL + 1))
    echo "  FAIL $name" >&2
  fi
}

echo "== test-agent =="

# --- static -------------------------------------------------------------------
check "argv is a fixed literal list" grep -q 'val argv = listOf(' "$LAUNCHER"
check "token is passed only to AgentConfig.encode" \
  grep -q 'AgentConfig.encode(token = token' "$LAUNCHER"
check "environment is built from scratch" \
  bash -c "grep -q 'val environment = linkedMapOf(' $LAUNCHER && ! grep -q 'System.getenv' $LAUNCHER"
check "environment keys are the documented five" \
  grep -q '"PATH" to "/system/bin"' "$LAUNCHER"
check "stdin payload ends with a newline" grep -q 'append("}\\n")' "$CONFIG"
check "the stdin pipe is closed after writing" \
  grep -q 'OutputStreamWriter(started.outputStream' "$PROCESS"
check "process environment is cleared before putting ours" \
  grep -q 'builder.environment().clear()' "$PROCESS"
check "no shell is used to launch" \
  bash -c "! grep -qE 'ProcessBuilder\(\"/system/bin/sh\"|sh -c' $PROCESS"

# --- dynamic ------------------------------------------------------------------
# The filtered run writes its reports to their own directory. Gradle clears one
# results directory per task at the start of every run, so running this filter
# into the default one deleted the full suite's evidence: 92 test classes became
# five result files, and the gate still said "JVM tests: OK". The property is
# read by engine/build.gradle.kts.
echo "  ..   running JVM tests"
if gradle -q :engine:testDebugUnitTest \
    --tests 'app.grom.server.agent.*' \
    --tests 'app.grom.server.core.AgentConfigTest' \
    --rerun \
    -PgromTestReportsDir=test-results/agent-only \
    --console=plain \
    -Dorg.gradle.jvmargs="-Xmx1024m -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8" >/tmp/grom-test-agent.log 2>&1; then
  PASS=$((PASS + 1))
  echo "  ok   agent JVM tests"
else
  FAIL=$((FAIL + 1))
  echo "  FAIL agent JVM tests (see /tmp/grom-test-agent.log)" >&2
fi

echo
if [ "$FAIL" -ne 0 ]; then
  echo "test-agent: FAILED ($PASS passed, $FAIL failed)" >&2
  exit 1
fi
echo "test-agent: OK ($PASS/$PASS)"
