<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions the engine's foreground service needs. Declaring them in the
         library means a host application that embeds the engine gets a working
         service without copying manifest entries by hand. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The Doctor (D82). ACCESS_NETWORK_STATE only lets the screen name the
         transport; it cannot read traffic. REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
         is what makes the one-tap "stop optimising this app" dialog possible, and
         Grom is installed by hand rather than through Play, which is the store
         policy that restricts it. No usage-stats, no queries-all-packages and no
         overlay permission is declared: where a probe needs one of those, the
         Doctor reports `unknown` instead of asking for it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The server network (D99-D103). Bluetooth is used only when the operator
         turns discovery on. On Android 12+ the three runtime permissions are
         requested from the screen; the legacy pair is capped at API 30 and
         fine location at API 32 (BLE/Wi-Fi Direct discovery below them). Both
         radio features are optional so a phone without them still installs and
         simply reports that carrier unavailable. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Both are declared because Android 12+ refuses a FINE request that does not
         also name COARSE, and lint treats the pair as one declaration. The screen
         still asks for FINE: BLE and Wi-Fi Direct discovery below API 31 need it,
         and a grant of COARSE only leaves the row saying exactly that. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />

    <application>
        <!--
          Embedded default (D55): the service is private to the host application
          and carries no IPC permission. A host that wants to expose the Binder
          surface declares it explicitly.

          The standalone Grom server role replaces this element with
          tools:node="replace" (app/src/server29/AndroidManifest.xml) and adds
          exported="true" plus the signature permission. `GromService` itself
          applies the per-transaction signature check in both cases.
        -->
        <service
            android:name="app.grom.server.service.GromService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="loopback-only local automation server" />
        </service>
    </application>
</manifest>
